# Copy this file to .env.local and fill in values for production.
# NEVER commit real keys. The demo build works without any of these.

# Server-side AI providers (read only by app/api/ai on the server)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (production data layer — see PLAN.md for schema)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private object storage bucket for uploads
STORAGE_BUCKET=sonet-stock-ai-uploads
